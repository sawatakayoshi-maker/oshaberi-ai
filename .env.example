# ─────────────────────────────────────────────
# Supabase
# ─────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# サーバー専用（バッチ処理・管理操作で使用、クライアントに絶対に露出させない）
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─────────────────────────────────────────────
# AI
# ─────────────────────────────────────────────
# 既定の AI プロバイダ: "claude" | "openai"
AI_PROVIDER=claude

# Claude (Anthropic)
ANTHROPIC_API_KEY=sk-ant-...
# 既定モデル。未指定なら claude-sonnet-4-6
# 画面（設定）で claude-sonnet-4-6 / claude-opus-4-8 を選択可能（モデル選択）
ANTHROPIC_MODEL=claude-sonnet-4-6
# 注: お話/AI秘書の「Web検索」は Anthropic の web_search ツールを使用します。
#     追加のAPIキーは不要ですが、検索利用料＋取得本文のトークンで費用が増えます。

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# ─────────────────────────────────────────────
# App
# ─────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
